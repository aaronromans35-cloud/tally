# Supabase (required) — get from supabase.com → project → settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Anthropic (required for AI plan + stock research) — console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# Upstash Redis (required for rate limiting) — console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# Alpha Vantage (optional — not currently used)
ALPHA_VANTAGE_API_KEY=your-key-here
