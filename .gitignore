# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit these
.env*
!.env.example

# backup folders
_backup*/

# vercel
.vercel

# Agent / skill tooling — vendored tool installs, not app code.
# ~14MB, and .agents/ duplicates .claude/skills/ byte for byte. Tracking it
# would put that weight in history permanently for everyone who clones.
# skills-lock.json IS tracked, so these can be reinstalled reproducibly.
.agents/
.claude/skills/
skills/
skill-zips/
project-instructions/
.impeccable/

# typescript
*.tsbuildinfo
next-env.d.ts
