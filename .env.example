# ---------------------------------------------------------------------------
# Tally environment
# ---------------------------------------------------------------------------
# NONE of these are required to run or deploy. Without them Tally runs in demo
# mode: the full app, seeded with believable data, persisted to localStorage.
# Each variable below switches on one more capability.
#
# Copy to .env.local for local dev. On Vercel, add them under
# Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------


# --- Accounts, persistence, guardian links -------------------------------
# Free tier at supabase.com → New project → Settings → API.
# After creating the project, run supabase/migrations/tally_core.sql in the
# SQL editor, then verify isolation with `npm run test:rls`.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# SERVER ONLY. Bypasses row-level security entirely, so it must never be
# prefixed NEXT_PUBLIC_ and never reach the browser. Used for the things a
# user must not be able to do to themselves: changing their own plan, and
# reading Plaid access tokens.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here


# --- AI coach -------------------------------------------------------------
# console.anthropic.com → API keys. Billed per call, so the coach is rate
# limited per minute and per day; see app/api/tally/coach/route.ts.
ANTHROPIC_API_KEY=sk-ant-api03-...


# --- Bank linking ---------------------------------------------------------
# dashboard.plaid.com → Team Settings → Keys. Sandbox is free and needs no
# approval; Production requires a signed agreement and a company.
#
# Note: Plaid's End User Services Agreement requires account holders to be 18
# or over, which is why Tally only offers bank linking to adults and
# guardians. Do not route a teen through this.
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-sandbox-secret
PLAID_ENV=sandbox


# --- Distributed rate limiting (optional) ---------------------------------
# console.upstash.com → Redis → free tier. Without it, rate limiting falls
# back to an in-process limiter: real, but per-instance, so a serverless
# deployment enforces it per cold start rather than globally. Fine for launch,
# worth adding before you have real traffic.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here


# --- Legacy (FinPath routes only, not used by Tally) ----------------------
ALPHA_VANTAGE_API_KEY=your-key-here
